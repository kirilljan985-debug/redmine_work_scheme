<div class="contextual">
  <%= link_to(l(:ws_label_back_to_scheme), work_scheme_path, class: 'icon icon-back') %>
</div>
<h2><%= l(:ws_label_edit_page) %></h2>
<% if @scheme[:errors].any? %>
  <div class="flash error">
    <%= l(:ws_error_invalid_scheme) %>
    <ul>
      <% @scheme[:errors].each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
  <p><%= link_to l(:ws_settings_json), controller: 'settings', action: 'plugin', id: 'redmine_work_scheme' %></p>
<% else %>
  <%= stylesheet_link_tag 'work_scheme', plugin: :redmine_work_scheme %>
  <%= javascript_include_tag 'work_scheme', plugin: :redmine_work_scheme %>
  <%= javascript_include_tag 'work_scheme_editor', plugin: :redmine_work_scheme %>
  <div id="ws-editor" data-save-url="<%= work_scheme_save_path %>"
       data-more-label="<%= l(:ws_label_more) %>"
       data-label-save="<%= l(:ws_label_save) %>"
       data-label-saved="<%= l(:ws_label_saved) %>"
       data-label-download="<%= l(:ws_label_download) %>"
       data-label-add-node="<%= l(:ws_label_add_node) %>"
       data-label-add-edge="<%= l(:ws_label_add_edge) %>"
       data-label-add-edge-hint="<%= l(:ws_label_add_edge_hint) %>"
       data-label-swap="<%= l(:ws_label_swap) %>"
       data-label-delete="<%= l(:ws_label_delete) %>"
       data-label-node="<%= l(:ws_label_node) %>"
       data-label-edge="<%= l(:ws_label_edge) %>"
       data-label-scenarios="<%= l(:ws_label_scenarios) %>"
       data-label-steps-hint="<%= l(:ws_label_steps_hint) %>"
       data-label-bend="<%= l(:ws_label_bend) %>">
    <div class="ws-editor-main">
      <div class="ws-container" data-work-scheme>
        <script type="application/json" class="ws-data"><%= RedmineWorkScheme::Scheme.safe_json(@scheme[:data]) %></script>
      </div>
    </div>
    <div class="ws-editor-side">
      <div id="ws-obj-panel"><em><%= l(:ws_label_node) %> / <%= l(:ws_label_edge) %></em></div>
      <div class="ws-editor-actions">
        <button type="button" id="ws-add-node" class="button"></button>
        <button type="button" id="ws-add-edge"></button>
      </div>
      <div class="ws-scenarios-block">
        <h4><%= l(:ws_label_scenarios) %></h4>
        <div id="ws-scenarios-list"></div>
        <button type="button" id="ws-add-scenario">+ <%= l(:ws_label_scenarios) %></button>
      </div>
      <div class="ws-editor-actions">
        <button type="button" id="ws-save" class="button"></button>
        <button type="button" id="ws-download"></button>
      </div>
      <div id="ws-save-status"></div>
    </div>
  </div>
<% end %>
