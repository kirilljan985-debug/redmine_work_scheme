<div class="contextual">
  <%= link_to(l(:ws_label_back_to_scheme), work_scheme_path, class: 'icon icon-back') %>
</div>
<h2 id="ws-editor-heading"><%= l(:ws_label_edit_page) %></h2>
<% if @scheme[:errors].any? %>
  <div class="flash error">
    <%= l(:ws_error_invalid_scheme) %>
    <ul>
      <% @scheme[:errors].each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
  <p><%= link_to l(:ws_settings_json), controller: 'settings', action: 'plugin', id: 'redmine_work_scheme' %></p>
<% else %>
  <%= stylesheet_link_tag 'work_scheme', plugin: :redmine_work_scheme %>
  <%= javascript_include_tag 'work_scheme', plugin: :redmine_work_scheme %>
  <%= javascript_include_tag 'work_scheme_editor', plugin: :redmine_work_scheme %>
  <div id="ws-editor" data-layout="modern" data-save-url="<%= work_scheme_save_path %>"
       data-more-label="<%= l(:ws_label_more) %>"
       data-label-save="<%= l(:ws_label_save) %>"
       data-label-saved="<%= l(:ws_label_saved) %>"
       data-label-download="<%= l(:ws_label_download) %>"
       data-label-add-node="<%= l(:ws_label_add_node) %>"
       data-label-add-edge="<%= l(:ws_label_add_edge) %>"
       data-label-add-edge-hint="<%= l(:ws_label_add_edge_hint) %>"
       data-label-swap="<%= l(:ws_label_swap) %>"
       data-label-delete="<%= l(:ws_label_delete) %>"
       data-label-node="<%= l(:ws_label_node) %>"
       data-label-edge="<%= l(:ws_label_edge) %>"
       data-label-scenarios="<%= l(:ws_label_scenarios) %>"
       data-label-steps-hint="<%= l(:ws_label_steps_hint) %>"
       data-label-bend="<%= l(:ws_label_bend) %>"
       data-label-edge-color="<%= l(:ws_label_edge_color) %>">
    <div class="ws-editor-main">
      <div class="ws-container" data-work-scheme data-layout="modern"
           data-counts-url="<%= work_scheme_counts_path %>"
           data-query-base-url="<%= issues_path %>">
        <%# Сырой JSON (<%==): см. комментарий в _block.html.erb — <%= сломал бы JSON.parse. %>
        <script type="application/json" class="ws-data"><%== RedmineWorkScheme::Scheme.safe_json(@scheme[:data]) %></script>
      </div>
    </div>
    <div class="ws-editor-side">
      <details class="ws-help">
        <summary><%= l(:ws_help_title) %></summary>
        <p><%= l(:ws_help_intro) %></p>
        <p><span class="ws-help-swatch ws-help-swatch-active"></span> <%= l(:ws_help_active) %> · <span class="ws-help-swatch ws-help-swatch-done"></span> <%= l(:ws_help_done) %> · <span class="ws-help-swatch ws-help-swatch-rework"></span> <%= l(:ws_help_rework) %></p>
      </details>
      <div class="ws-title-control">
        <label for="ws-title"><%= l(:ws_label_scheme_title) %></label>
        <input id="ws-title" type="text" value="">
      </div>
      <div class="ws-theme-control">
        <label for="ws-theme"><%= l(:ws_label_theme) %></label>
        <select id="ws-theme">
          <option value="classic">Redmine Classic</option>
          <option value="ocean">Ocean Blue</option>
          <option value="graphite">Graphite Dark</option>
          <option value="warm">Warm Office</option>
          <option value="paper">Paper Canvas</option>
        </select>
      </div>
      <details class="ws-properties">
        <summary><%= l(:ws_label_node) %> / <%= l(:ws_label_edge) %></summary>
        <div id="ws-obj-panel"><em><%= l(:ws_label_node) %> / <%= l(:ws_label_edge) %></em></div>
      </details>
      <details class="ws-palette">
        <summary><%= l(:ws_label_palette) %></summary>
        <p class="ws-panel-hint"><%= l(:ws_label_palette_hint) %></p>
        <div class="ws-palette-group">
          <strong><%= l(:ws_label_palette_nodes) %></strong>
          <div class="ws-palette-items">
            <button type="button" draggable="true" class="ws-palette-item ws-palette-node-start" data-palette-kind="node" data-node-type="start"><%= l(:ws_palette_start) %></button>
            <button type="button" draggable="true" class="ws-palette-item ws-palette-node-process" data-palette-kind="node" data-node-type="process"><%= l(:ws_palette_process) %></button>
            <button type="button" draggable="true" class="ws-palette-item ws-palette-node-decision" data-palette-kind="node" data-node-type="decision"><%= l(:ws_palette_decision) %></button>
            <button type="button" draggable="true" class="ws-palette-item ws-palette-node-end" data-palette-kind="node" data-node-type="end"><%= l(:ws_palette_end) %></button>
          </div>
        </div>
        <div class="ws-palette-group">
          <strong><%= l(:ws_label_palette_edges) %></strong>
          <div class="ws-palette-items">
            <button type="button" draggable="true" class="ws-palette-item" data-palette-kind="edge" data-edge-route="straight"><%= l(:ws_palette_edge) %></button>
            <button type="button" draggable="true" class="ws-palette-item" data-palette-kind="edge" data-edge-route="arc"><%= l(:ws_palette_arc) %></button>
            <button type="button" draggable="true" class="ws-palette-item" data-palette-kind="edge" data-edge-route="elbow"><%= l(:ws_palette_elbow) %></button>
            <button type="button" draggable="true" class="ws-palette-item" data-palette-kind="edge" data-edge-route="u" data-edge-bend="100"><%= l(:ws_palette_u) %></button>
          </div>
        </div>
        <div class="ws-palette-group">
          <strong><%= l(:ws_label_palette_icons) %></strong>
          <div class="ws-palette-items">
            <% [['user', :ws_icon_user], ['document', :ws_icon_document], ['search', :ws_icon_search], ['decision', :ws_icon_decision], ['certificate', :ws_icon_certificate], ['gear', :ws_icon_gear], ['rocket', :ws_icon_rocket]].each do |icon| %>
              <button type="button" draggable="true" class="ws-palette-item ws-palette-icon" data-palette-kind="icon" data-icon="<%= icon[0] %>"><%= l(icon[1]) %></button>
            <% end %>
          </div>
        </div>
      </details>
      <details class="ws-scenarios-block">
        <summary><%= l(:ws_label_scenarios) %></summary>
        <p class="ws-scenario-hint"><%= l(:ws_scenario_capture_hint) %></p>
        <div id="ws-scenarios-list"></div>
        <button type="button" id="ws-add-scenario">+ <%= l(:ws_label_scenarios) %></button>
      </details>
      <div class="ws-editor-actions">
        <details class="ws-action-section ws-action-section-history">
          <summary><%= l(:ws_section_history) %></summary>
          <div class="ws-action-group">
            <button type="button" id="ws-undo"><%= l(:ws_action_undo) %></button>
            <button type="button" id="ws-redo"><%= l(:ws_action_redo) %></button>
          </div>
        </details>
        <details class="ws-action-section ws-action-section-align">
          <summary><%= l(:ws_section_align) %></summary>
          <div class="ws-action-group">
            <button type="button" id="ws-align-x"><%= l(:ws_action_align_x) %></button>
            <button type="button" id="ws-align-y"><%= l(:ws_action_align_y) %></button>
            <button type="button" id="ws-distribute-x"><%= l(:ws_action_distribute_x) %></button>
            <button type="button" id="ws-distribute-y"><%= l(:ws_action_distribute_y) %></button>
          </div>
        </details>
        <details class="ws-action-section ws-action-section-object">
          <summary><%= l(:ws_section_object) %></summary>
          <div class="ws-action-group">
            <button type="button" id="ws-duplicate"><%= l(:ws_action_duplicate) %></button>
          </div>
        </details>
        <div class="ws-action-section ws-action-section-file">
          <div class="ws-action-title"><%= l(:ws_section_file) %></div>
          <div class="ws-action-group">
            <button type="button" id="ws-save" class="button"></button>
            <button type="button" id="ws-download"></button>
          </div>
        </div>
      </div>
      <div id="ws-save-status"></div>
    </div>
  </div>
<% end %>
