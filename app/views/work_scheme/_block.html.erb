<%# Блок со схемой: страница /work_scheme, дашборды additionals 4.7+
    (класс DashboardBlocks::WorkSchemeBlock) и 4.6 (legacy-патч
    DashboardContent, locals: dashboard/settings/block/block_definition/user).
    Источник схемы определяется по контексту. %>
<% ws_dash_block = defined?(dashboard_block) && dashboard_block %>
<%# Ключ экземпляра в layout бывает с суффиксом (work_scheme__2) — нормализуем,
    но сырой block сохраняется для id формы и имён полей настроек. %>
<% ws_legacy_block = !ws_dash_block && defined?(block) && block.to_s =~ /\Awork_scheme(__\d+)?\z/ %>
<% ws_legacy_dash = ws_legacy_block && defined?(settings) && settings.is_a?(Hash) %>
<% scheme ||= (ws_dash_block ? dashboard_block.scheme : (ws_legacy_dash ? RedmineWorkScheme::Scheme.from_settings : nil)) %>
<% if ws_dash_block %>
  <% ws_width = dashboard_block.width %>
  <% ws_height = dashboard_block.height %>
<% elsif ws_legacy_dash %>
  <%# Настройки хранятся без whitelist — клампим на чтении; ключи бывают
      и символьные, и строковые (раундтрип настроек дашборда). %>
  <% ws_width = (settings[:width] || settings['width']).to_i %>
  <% ws_width = 100 if ws_width <= 0 %>
  <% ws_width = 30 if ws_width < 30 %>
  <% ws_width = 100 if ws_width > 100 %>
  <% ws_height = (settings[:height] || settings['height']).to_i %>
  <% ws_height = 420 if ws_height <= 0 %>
  <% ws_height = 200 if ws_height < 200 %>
  <% ws_height = 1200 if ws_height > 1200 %>
<% end %>
<% additionals_block = ws_dash_block || ws_legacy_dash %>
<%# Ссылка редактора из блока несёт back-путь текущей страницы: «К схеме»
    из редактора вернёт пользователя на дашборд, а не на /work_scheme.
    defined?-гвард — standalone-рендер партиала в тестах без request;
    .presence — у рендерера path пустая строка, а не «/» (в Ruby truthy). %>
<% ws_back_path = additionals_block && defined?(request) && request.respond_to?(:path) ? request.path.presence : nil %>
<% if scheme %>
  <% if scheme[:errors].any? %>
    <div class="flash error ws-empty-state">
      <%= l(:ws_error_invalid_scheme) %>
      <ul>
        <% scheme[:errors].each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
      <p><%= l(:ws_hint_check_settings) %></p>
    </div>
  <% else %>
    <%= stylesheet_link_tag 'work_scheme', plugin: :redmine_work_scheme %>
    <%= javascript_include_tag 'work_scheme', plugin: :redmine_work_scheme %>
    <div class="ws-container<%= ' ws-additionals-block' if additionals_block %>" data-work-scheme data-layout="modern"<% if additionals_block %> style="--ws-block-width: <%= ws_width %>%; --ws-block-height: <%= ws_height %>px;"<% end %>
         data-stage-base-url="<%= work_scheme_stage_path('__ID__').gsub('__ID__', '') %>"
         data-counts-url="<%= work_scheme_counts_path %>"
         data-query-base-url="<%= issues_path %>"
         data-label-play="<%= l(:ws_label_play) %>"
         data-label-reset="<%= l(:ws_label_reset) %>"
         data-label-playback-step="<%= l(:ws_label_playback_step) %>"
         data-label-playback-done="<%= l(:ws_label_playback_done) %>"
         data-label-no-scenarios="<%= l(:ws_note_no_scenarios) %>"
         data-label-tasks="<%= l(:ws_label_tasks) %>"
         data-label-progress="<%= l(:ws_label_progress) %>"
         data-label-speed="<%= l(:ws_label_speed) %>"
         data-label-zoom-out="<%= l(:ws_label_zoom_out) %>"
         data-label-zoom-in="<%= l(:ws_label_zoom_in) %>"
         data-label-zoom-fit="<%= l(:ws_label_zoom_fit) %>"
         data-label-edit-page="<%= l(:ws_label_edit_page) %>"
         data-edit-url="<%= User.current.admin? ? (ws_back_path ? work_scheme_edit_path(back: ws_back_path) : work_scheme_edit_path) : '' %>"
         data-more-label="<%= l(:ws_label_more) %>">
      <%# JSON выводится сырым (<%==): внутри <script> HTML-сущности не декодируются,
          а кавычки после <%= превратились бы в &quot; и сломали JSON.parse.
          Вылет из тега ("<" в данных) уже закрыт заменой в Scheme.safe_json. %>
      <script type="application/json" class="ws-data"><%== RedmineWorkScheme::Scheme.safe_json(scheme[:data]) %></script>
    </div>
  <% end %>
<% end %>
<%# Форма настроек — только legacy-поколение (4.6): шестерёнка additionals
    переключает этот скрытый div; в 4.7+ форму строит класс-система. Форма
    вне гейта валидности схемы: при битом JSON шестерёнка должна работать,
    чтобы админ мог починить блок. Условия повторяют гейт шестерёнки
    (editable? и не locked?); dashboard — локал из build_dashboard_partial_locals,
    defined? нужен, чтобы партиал не падал без него вне дашборда. %>
<% if ws_legacy_dash && defined?(dashboard) && dashboard.respond_to?(:editable?) &&
      dashboard.editable? && !dashboard.try(:locked?) %>
  <div class="hidden" id="<%= block %>-settings">
    <%= remote_form_tag _update_layout_setting_dashboard_path(@project, dashboard) do %>
      <%= render 'work_scheme/settings', block: block, settings: settings %>
      <p><%= submit_tag l(:button_save) %>
         <%= link_to_function l(:button_cancel), "$('##{block}-settings').toggle()" %></p>
    <% end %>
  </div>
<% end %>
